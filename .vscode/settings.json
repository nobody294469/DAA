{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["src"],
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.typeCheckingMode": "off",
  "terminal.integrated.env.windows": { "PYTHONPATH": "${workspaceFolder}/src" },
  "files.autoSave": "afterDelay",
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true },
  "files.watcherExclude": { "**/data/**": true, "**/.venv*/**": true, "**/presentation/node_modules/**": true, "**/dist/**": true, "**/.git/objects/**": true },
  "search.exclude": { "**/data": true, "**/.venv*": true, "**/node_modules": true, "**/dist": true, "**/reports": true },
  "git.autofetch": false,
  "git.openRepositoryInParentFolders": "never",
  "telemetry.telemetryLevel": "off"
}
