{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System Health & Component Readiness",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "READY" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.3.3",
      "targets": [{ "expr": "clindoc_model_readiness{model=\"modernbert\"}", "refId": "A" }],
      "title": "ModernBERT Readiness",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "UNAVAILABLE" }, "1": { "color": "green", "text": "READY" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.3.3",
      "targets": [{ "expr": "clindoc_model_readiness{model=\"qwen\"}", "refId": "A" }],
      "title": "Qwen / vLLM Availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "green", "text": "CLOSED" }, "1": { "color": "yellow", "text": "HALF-OPEN" }, "2": { "color": "red", "text": "OPEN" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.3.3",
      "targets": [{ "expr": "clindoc_circuit_breaker_state{model=\"vllm_gateway\"}", "refId": "A" }],
      "title": "Circuit Breaker State",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "pluginVersion": "10.3.3",
      "targets": [{ "expr": "clindoc_jobs_in_progress", "refId": "A" }],
      "title": "Active Jobs In Progress",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "title": "Throughput & Volume",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
      "id": 5,
      "targets": [{ "expr": "sum by (status) (rate(clindoc_documents_total[1m])) * 60", "legendFormat": "{{status}}", "refId": "A" }],
      "title": "Documents Processed / Minute",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 6 },
      "id": 6,
      "targets": [{ "expr": "sum by (stage, outcome) (rate(clindoc_claims_total[1m])) * 60", "legendFormat": "{{stage}} - {{outcome}}", "refId": "A" }],
      "title": "Claims Evaluated / Minute",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 6 },
      "id": 7,
      "targets": [{ "expr": "rate(clindoc_jobs_total{status=\"completed\"}[5m]) * 60", "legendFormat": "completed/min", "refId": "A" }],
      "title": "Job Completion Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 300,
      "title": "Pipeline Latency (P95 & P50)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 13 },
      "id": 8,
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(clindoc_job_duration_seconds_bucket[5m])))", "legendFormat": "Job P95", "refId": "A" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(clindoc_job_duration_seconds_bucket[5m])))", "legendFormat": "Job P50", "refId": "B" }
      ],
      "title": "End-to-End Job Processing Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 13 },
      "id": 9,
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(clindoc_stage_duration_seconds_bucket[5m])))", "legendFormat": "{{stage}} P95", "refId": "A" }
      ],
      "title": "Cascade Stages Latency (Stage A / B / C)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 13 },
      "id": 10,
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(clindoc_fhir_export_duration_seconds_bucket[5m])))", "legendFormat": "FHIR Export P95", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, model) (rate(clindoc_model_request_duration_seconds_bucket[5m])))", "legendFormat": "{{model}} Inference P95", "refId": "B" }
      ],
      "title": "Model Inference & FHIR Export Latency",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 400,
      "title": "Verification Cascade & Fallback Analysis",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 20 },
      "id": 11,
      "targets": [{ "expr": "sum by (stage) (rate(clindoc_cascade_evaluations_total[5m]))", "legendFormat": "{{stage}}", "refId": "A" }],
      "title": "Cascade Stage Evaluation Distribution",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 20 },
      "id": 12,
      "targets": [
        { "expr": "sum(rate(clindoc_cascade_evaluations_total{stage=\"stage_b\", outcome=\"escalated\"}[5m])) / (sum(rate(clindoc_cascade_evaluations_total{stage=\"stage_b\"}[5m])) + 0.0001)", "legendFormat": "Stage B Escalation %", "refId": "A" },
        { "expr": "sum(rate(clindoc_stage_c_fallbacks_total[5m])) / (sum(rate(clindoc_cascade_evaluations_total{stage=\"stage_c\"}[5m])) + 0.0001)", "legendFormat": "Stage C Fallback %", "refId": "B" }
      ],
      "title": "Escalation & Fallback Ratios",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 20 },
      "id": 13,
      "targets": [{ "expr": "sum by (reason) (rate(clindoc_stage_c_fallbacks_total[5m]))", "legendFormat": "{{reason}}", "refId": "A" }],
      "title": "Stage C Fallback Reasons",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 500,
      "title": "Human Review Workbench & Queue",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 27 },
      "id": 14,
      "targets": [{ "expr": "clindoc_review_queue_size", "refId": "A" }],
      "title": "Review Queue Size",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 27 },
      "id": 15,
      "targets": [{ "expr": "sum by (action, outcome) (rate(clindoc_review_claims_total[5m])) * 60", "legendFormat": "{{action}} ({{outcome}})", "refId": "A" }],
      "title": "Review Actions / Minute",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 27 },
      "id": 16,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(clindoc_review_duration_seconds_bucket[10m])))", "legendFormat": "Review Duration P95", "refId": "A" }],
      "title": "Review Processing Duration",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 600,
      "title": "Errors, Failures & Security Events",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 33 },
      "id": 17,
      "targets": [{ "expr": "sum by (status_class) (rate(clindoc_http_requests_total{status_class=~\"4xx|5xx\"}[5m]))", "legendFormat": "{{status_class}}", "refId": "A" }],
      "title": "API Errors (4xx / 5xx)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 33 },
      "id": 18,
      "targets": [{ "expr": "sum by (event_type) (rate(clindoc_security_events_total[5m]))", "legendFormat": "{{event_type}}", "refId": "A" }],
      "title": "Security & Ingestion Screening Rejections",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 33 },
      "id": 19,
      "targets": [{ "expr": "sum by (model, outcome) (rate(clindoc_model_requests_total{outcome!=\"success\"}[5m]))", "legendFormat": "{{model}} - {{outcome}}", "refId": "A" }],
      "title": "Model Serving Failures & Retries",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 33 },
      "id": 20,
      "targets": [{ "expr": "sum by (status, reason) (rate(clindoc_fhir_exports_total{status!=\"success\"}[5m]))", "legendFormat": "{{status}} - {{reason}}", "refId": "A" }],
      "title": "FHIR Export Failures",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["clindoc", "production", "operations", "monitoring"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "ClinDoc Operational Monitoring",
  "uid": "clindoc-ops-dashboard",
  "version": 1
}
