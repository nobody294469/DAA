# Copy to ".env" (git-ignored) in the project folder and fill in. clindoc serve loads it automatically.
# Everything here is optional: with no key the whole system runs offline on this machine.

# --- Online LLM (opt-in). PRIVACY: enabling it sends uploaded-document text to the host below. ---
# Any OpenAI-compatible endpoint works (OpenAI, Groq, Together, OpenRouter, Azure, your own vLLM).
CLINDOC_ONLINE_API_KEY=
CLINDOC_ONLINE_BASE_URL=https://api.openai.com/v1
CLINDOC_ONLINE_MODEL=gpt-4o-mini
# Stage C judge: off = local Qwen only | both = local first, hosted model as backup | online = hosted only
CLINDOC_ONLINE_JUDGE=both

# --- Google sign-in (see docs/deploy.md) ---
# CLINDOC_GOOGLE_CLIENT_ID=
# CLINDOC_SESSION_SECRET=
